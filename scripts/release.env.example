# Copy to ~/.anycode/release.env and fill in (never commit secrets).
# Used by scripts/release-desktop-local.sh for signed + notarized DMG builds.

export APPLE_SIGNING_IDENTITY="Developer ID Application: Your Name (TEAMID)"
export APPLE_TEAM_ID="XXXXXXXXXX"
export APPLE_ID="you@example.com"
export APPLE_PASSWORD="xxxx-xxxx-xxxx-xxxx"  # or APP_SPECIFIC_PASSWORD (iching-style)

# Optional: where to copy DMG for portal/nginx static hosting
# export ANYCODE_DOWNLOAD_DIR="/path/to/account-portal/public/downloads"

# Packaging target (see scripts/lib/build-target.sh):
#   local  — loopback login (127.0.0.1:43200/43201); use build-desktop-local.sh
#   cloud  — anycode.work; default for release-desktop-local.sh / CI
# export ANYCODE_BUILD_TARGET=cloud

# Optional: rsync/scp upload after build (example)
# export ANYCODE_DOWNLOAD_UPLOAD='rsync -avz "$DMG" user@host:/var/www/anycode.work/downloads/'

# In-place updater signing (minisign keypair; generate with
# `cargo tauri signer generate -W ~/.anycode/keys/anycode-updater.key`).
# Required so release builds emit signed updater artifacts (.app.tar.gz.sig /
# nsis .sig) for the official-site update manifest. The pubkey lives in
# apps/anycode-desktop/tauri.conf.json (plugins.updater.pubkey).
export TAURI_SIGNING_PRIVATE_KEY="$(cat ~/.anycode/keys/anycode-updater.key)"
export TAURI_SIGNING_PRIVATE_KEY_PASSWORD=""

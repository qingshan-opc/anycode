#!/usr/bin/env python3
"""anycode-ppt: creative HTML slide deck — skin from VisualBrief, no pptx export."""
from __future__ import annotations

import shutil
import subprocess
import sys
from pathlib import Path

SKILL_DIR = Path(__file__).resolve().parent
REPO = SKILL_DIR.parents[1] if (SKILL_DIR.parents[1] / "brand-kits").is_dir() else SKILL_DIR.parents[2]
BRAND = "fde-editorial"


def ensure_echarts_vendor(deck_dir: Path) -> None:
    """Copy local ECharts into the deck so file:// pages work offline."""
    src = SKILL_DIR / "vendor" / "echarts.min.js"
    if not src.is_file():
        return
    dest_dir = deck_dir / "vendor"
    dest_dir.mkdir(parents=True, exist_ok=True)
    dest = dest_dir / "echarts.min.js"
    if not dest.is_file() or dest.stat().st_size != src.stat().st_size:
        shutil.copy2(src, dest)
        print(f"vendor: {dest}")


def main() -> int:
    if len(sys.argv) < 2:
        print("usage: run slides_dir", file=sys.stderr)
        return 1
    src = Path(sys.argv[1]).resolve()

    design_run = REPO / "scripts" / "office" / "build_presentation_design.py"
    validator = REPO / "scripts" / "office" / "validate_slide_html.py"
    index_py = REPO / "scripts" / "office" / "build_slide_deck_index.py"

    for step, cmd in [
        ("design", [sys.executable, str(design_run), str(src), BRAND]),
        ("validate", [sys.executable, str(validator), str(src), "anycode-ppt"]),
        ("index", [sys.executable, str(index_py), str(src)]),
    ]:
        proc = subprocess.run(cmd, capture_output=True, text=True)
        if proc.returncode != 0:
            sys.stderr.write(f"[{step}] failed\n{proc.stderr or proc.stdout}")
            return proc.returncode
        if proc.stdout.strip():
            print(proc.stdout.strip())

    slides = sorted(src.glob("*.html"))
    if not slides and (src / "slides").is_dir():
        slides = sorted((src / "slides").glob("*.html"))
    slides = [s for s in slides if s.name.lower() != "index.html"]
    deck_dir = slides[0].parent if slides else src
    ensure_echarts_vendor(deck_dir)
    index = deck_dir / "index.html"
    print(f"slides: {len(slides)} pages in {deck_dir}")
    print(f"deck: {index}")
    print(f"manifest: {src / 'slide_manifest.json'}")
    return 0


if __name__ == "__main__":
    raise SystemExit(main())
